# Optional. Without a key the weekly advice falls back to a rule-based summary,
# so the whole app works with no configuration at all.
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-opus-5-5

# Set to true to let the API serve the built front-end (single-container deployment).
SERVE_FRONTEND=false

# Set to true to skip all external calls (OSRM, Open-Meteo, Nominatim).
OFFLINE=false

# JSON list of allowed front-end origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
